<Page x:Class="VetClinic.Pages.AddAppointmentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VetClinic.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="{Binding Title}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="tbHeader" FontSize="20" FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Клиент:" VerticalAlignment="Center" Width="100"/>
                <ComboBox x:Name="cbClient" Width="300"
                          DisplayMemberPath="FIO"
                          SelectedValuePath="Id"
                          SelectionChanged="cbClient_SelectionChanged"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Питомец:" VerticalAlignment="Center" Width="100"/>
                <ComboBox x:Name="cbPet" Width="300"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Ветеринар:" VerticalAlignment="Center" Width="100"/>
                <ComboBox x:Name="cbVet" Width="300"
                          DisplayMemberPath="FIO"
                          SelectedValuePath="Id"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Услуга:" VerticalAlignment="Center" Width="100"/>
                <ComboBox x:Name="cbService" Width="300"
                          DisplayMemberPath="ServiceName"
                          SelectedValuePath="Id"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Дата и время:" VerticalAlignment="Center" Width="100"/>
                <DatePicker x:Name="dpDate" Width="200"/>
                <TextBlock Text=" " Width="10"/>
                <TextBox x:Name="txtTime" Width="80" Text="10:00"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Статус:" VerticalAlignment="Center" Width="100"/>
                <ComboBox x:Name="cbStatus" Width="200"
                          DisplayMemberPath="StatusName"
                          SelectedValuePath="Id"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Описание:" VerticalAlignment="Center" Width="100"/>
                <TextBox x:Name="txtDescription" Width="400" Height="60"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Сохранить" Click="Save_Click"/>
            <Button Content="Назад" Click="Back_Click" Background="#AAAAAA"/>
        </StackPanel>
    </Grid>
</Page>