<Page x:Class="VetClinic.Pages.AdminMenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VetClinic.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
       Title="Управление системой">

    <Page.Resources>
        <Style TargetType="Button" x:Key="MenuButtonStyle">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Background" Value="#9B7ED9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="1" BorderBrush="#7A5CC2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#7A5CC2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Панель управления системой" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Foreground="#6A4C93" 
                   Margin="0,0,0,30" 
                   HorizontalAlignment="Center"/>

        <WrapPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" ItemWidth="220" ItemHeight="100">
            <Button Content="📅 Записи на приём" Style="{StaticResource MenuButtonStyle}" Click="BtnAppointments_Click"/>
            <Button Content="🐾 Питомцы" Style="{StaticResource MenuButtonStyle}" Click="BtnPets_Click"/>
            <Button Content="💉 Услуги" Style="{StaticResource MenuButtonStyle}" Click="BtnServices_Click"/>
            <Button Content="💊 Лекарства" Style="{StaticResource MenuButtonStyle}" Click="BtnMedicines_Click"/>
            <Button Content="📦 Заказы" Style="{StaticResource MenuButtonStyle}" Click="BtnOrders_Click"/>
            <Button Content="👥 Пользователи" Style="{StaticResource MenuButtonStyle}" Click="BtnUsers_Click"/>
            <Button Content="← Вернуться назад" Style="{StaticResource MenuButtonStyle}" Click="BtnBack_Click"/>
        </WrapPanel>
    </Grid>
</Page>