<Page x:Class="VetClinic.Pages.AppointmentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VetClinic.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Записи на приём — Лапа и Хвост">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="filterPanel" Grid.Row="0" Orientation="Horizontal" Margin="5">
            <ComboBox x:Name="cmbSort" Width="180" Margin="5" SelectionChanged="Filters_Changed"/>
            <ComboBox x:Name="cmbFilter" Width="200" Margin="5" SelectionChanged="Filters_Changed"/>
            <TextBox x:Name="txtSearch" Width="250" Margin="5" TextChanged="Filters_Changed"
                     ToolTip="Поиск по питомцу, услуге, ветеринару"/>
        </StackPanel>

        <ListView x:Name="listAppointments" Grid.Row="1" MouseDoubleClick="listAppointments_MouseDoubleClick"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="5" Padding="10" BorderBrush="#9B7ED9"
                            BorderThickness="1" Background="#E8DEF5" CornerRadius="4"
                            HorizontalAlignment="Stretch">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock FontWeight="Bold" TextWrapping="Wrap">
                                    <Run Text="Услуга:"/>
                                    <Run Text="{Binding ServiceName, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="Питомец:"/>
                                    <Run Text="{Binding PetInfo, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="Ветеринар:"/>
                                    <Run Text="{Binding VetName, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0">
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="Дата:"/>
                                    <Run Text="{Binding AppointmentDate, StringFormat=dd.MM.yyyy HH:mm}"/>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Text="{Binding StatusName, Mode=OneWay}"
                                       Margin="5,0"/>

                            <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                       TextWrapping="Wrap" 
                                       FontSize="12"
                                       Text="{Binding Description}"
                                       Margin="5,0,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="Добавить" Click="Add_Click"/>
            <Button Content="Редактировать" Click="Edit_Click"/>
            <Button Content="Удалить" Background="#FFB3B3" Click="Del_Click"/>
            <Button Content="Назад" Click="Back_Click" Background="#AAAAAA"/>
        </StackPanel>
    </Grid>
</Page>