<Page x:Class="VetClinic.Pages.AuthorizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VetClinic.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Авторизация — Лапа и Хвост">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="350">
            <Image Source="/Images/icon.jpg" Height="100" Stretch="Uniform" Margin="0,0,0,20"/>

            <TextBlock Text="Вход в систему" FontSize="26" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,30" Foreground="#5A3E85"/>

            <TextBlock Text="Email:" FontSize="16" Margin="0,0,0,5"/>
            <TextBox x:Name="txtLogin" FontSize="16" Height="35"/>

            <TextBlock Text="Пароль:" FontSize="16" Margin="0,15,0,5"/>
            <PasswordBox x:Name="txtPassword" FontSize="16" Height="35" 
                         PasswordChar="●"/>

            <Button Content="Войти" Click="Login_Click" Height="40" Margin="0,20,0,10"/>
            <Button Content="Регистрация" Click="Register_Click" 
                    Height="40" Margin="0,5,0,10" Background="#E8DEF5" 
                    Foreground="#5A3E85"/>
            <Button Content="Войти как гость" Click="Guest_Click" 
                    Background="#AAAAAA" Height="40"/>
        </StackPanel>
    </Grid>
</Page>