<Page x:Class="VetClinic.Pages.CartServicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VetClinic.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Корзина услуг — Лапа и Хвост">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Выбранные услуги для записи" FontSize="24"
                   FontWeight="Bold" Margin="0,0,0,10"/>

        <ListView x:Name="listCart" Grid.Row="1">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#9B7ED9" BorderThickness="1"
                            CornerRadius="4" Margin="5" Padding="10"
                            Background="#E8DEF5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock FontWeight="Bold"
                                           Text="{Binding ServiceName}"/>
                                <TextBlock>
                                    <Run Text="Длительность:"/>
                                    <Run Text="{Binding DurationMinutes}"/>
                                    <Run Text=" мин"/>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       Text="{Binding Price, StringFormat={}{0:N2} ₽}"/>

                            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                       Text="{Binding Quantity}"/>

                            <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                       FontWeight="Bold"
                                       Text="{Binding Sum, Mode=OneWay, StringFormat={}{0:N2} ₽}"/>

                            <Button Grid.Column="4" Content="Удалить"
                                    Background="#FFB3B3" Click="Remove_Click"
                                    Tag="{Binding}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Выбор даты и времени -->
        <StackPanel Grid.Row="2" Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <TextBlock Text="Дата и время приёма:" FontSize="16" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <DatePicker x:Name="dpAppointmentDate" Width="180" Margin="0,0,10,0"/>
                <TextBlock Text="время:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="txtTime" Width="80" Text="10:00"
                         VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="tbTotal" FontSize="20" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,20,0"/>
                <Button Content="Оформить запись" Width="200" Click="Checkout_Click"/>
                <Button Content="Очистить" Width="150" Background="#AAAAAA" Click="Clear_Click"/>
                <Button Content="Назад" Width="150" Click="Back_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>