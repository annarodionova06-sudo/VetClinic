<Page x:Class="VetClinic.Pages.MedicineDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VetClinic.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
Title="Редактирование лекарства">
    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="500" HorizontalAlignment="Center">
                <TextBlock Text="Редактирование лекарства" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#5A3E85"/>

                <TextBlock Text="Артикул *" FontSize="14" Margin="0,0,0,5"/>
                <TextBox x:Name="txtArticle" Height="35"/>

                <TextBlock Text="Название *" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtName" Height="35"/>

                <TextBlock Text="Категория *" FontSize="14" Margin="0,10,0,5"/>
                <ComboBox x:Name="cmbCategory" Height="35" DisplayMemberPath="CategoryName"
                          SelectedValuePath="Id"/>

                <TextBlock Text="Производитель *" FontSize="14" Margin="0,10,0,5"/>
                <ComboBox x:Name="cmbManufacturer" Height="35" DisplayMemberPath="ManufacturerName"
                          SelectedValuePath="Id"/>

                <TextBlock Text="Форма выпуска *" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtReleaseForm" Height="35"/>

                <TextBlock Text="Цена (₽) *" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtPrice" Height="35"/>

                <TextBlock Text="Скидка (%)" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtDiscount" Height="35" Text="0"/>

                <TextBlock Text="Количество на складе *" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtStock" Height="35"/>

                <TextBlock Text="Описание" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtDescription" Height="80" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>

                <CheckBox x:Name="chkPrescription" Content="Требуется рецепт"
                          Margin="0,15,0,0" FontSize="14"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Content="Сохранить" Width="150" Height="40" Click="Save_Click"/>
                    <Button Content="Отмена" Width="150" Height="40" Margin="10,0,0,0"
                            Click="Cancel_Click" Background="#AAAAAA"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>