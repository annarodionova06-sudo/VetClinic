<Page x:Class="VetClinic.Pages.MedicinesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VetClinic.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
       Title="Лекарства — Лапа и Хвост">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель фильтров -->
        <StackPanel x:Name="filterPanel" Grid.Row="0" Orientation="Horizontal" Margin="5">
            <ComboBox x:Name="cmbSort" Width="180" Margin="5" SelectionChanged="Filters_Changed"/>
            <ComboBox x:Name="cmbFilter" Width="180" Margin="5" SelectionChanged="Filters_Changed"/>
            <TextBox x:Name="txtSearch" Width="250" Margin="5" TextChanged="Filters_Changed"
                     ToolTip="Поиск по наименованию"/>
        </StackPanel>

        <ListView x:Name="listMedicines" Grid.Row="1" 
          MouseDoubleClick="listMedicines_MouseDoubleClick"
          HorizontalContentAlignment="Stretch">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="5" Padding="15" BorderBrush="#9B7ED9" BorderThickness="1"
                    Background="{Binding RowColor, Mode=OneWay}" CornerRadius="4"
                    MinHeight="120">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0" Source="{Binding ImagePathDisplay, Mode=OneWay}"
                           Width="100" Height="100" Stretch="Uniform"/>

                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock FontWeight="Bold">
                            <Run Text="{Binding Manufacturers.ManufacturerName}"/>
                            <Run Text=" | "/>
                            <Run Text="{Binding Name}"/>
                                </TextBlock>
                                <TextBlock>
                            <Run Text="Категория:"/>
                            <Run Text="{Binding MedicineCategories.CategoryName}"/>
                                </TextBlock>
                                <TextBlock>
                            <Run Text="Количество:"/>
                            <Run Text="{Binding QuantityText, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock>
                            <Run Text="Форма выпуска:"/>
                            <Run Text="{Binding ReleaseForm}"/>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0">
                                <TextBlock FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Right" Margin="0,0,0,4"
                                   Text="{Binding FinalPrice, Mode=OneWay, StringFormat={}{0:N2} ₽}"/>
                                <TextBlock Foreground="Red" TextDecorations="Strikethrough"
                                   HorizontalAlignment="Right" Margin="0,0,0,8"
                                   Text="{Binding Price, Mode=OneWay, StringFormat={}{0:N2} ₽}"
                                   Visibility="{Binding HasDiscount, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                                <Button Content="В корзину" Width="120" Height="30"
                                Click="AddMedicineToCart_Click"
                                Tag="{Binding}"
                                FontSize="12" Padding="5,3"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Нижние кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <!-- Кнопка удаления скрыта по умолчанию, показывается только админу в коде -->
            <Button x:Name="btnDelete" Content="Удалить" Background="#FFB3B3"
                    Click="Del_Click" Visibility="Collapsed"/>
            <Button Content="Корзина лекарств" Click="Cart_Click"/>
            <Button Content="Назад" Click="Back_Click" Background="#AAAAAA"/>
        </StackPanel>
    </Grid>
</Page>