<Page x:Class="VetClinic.Pages.MyAppointmentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VetClinic.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Мои записи — Лапа и Хвост">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Мои записи на приём" FontSize="24"
                   FontWeight="Bold" Margin="0,0,0,10"/>

        <ListView x:Name="listAppointments" Grid.Row="1">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="5" Padding="10" BorderBrush="#9B7ED9"
                            BorderThickness="1" Background="#E8DEF5" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock FontWeight="Bold"
                                           Text="{Binding ServiceName, Mode=OneWay}"/>
                                <TextBlock>
                                    <Run Text="Питомец:"/>
                                    <Run Text="{Binding PetInfo, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Ветеринар:"/>
                                    <Run Text="{Binding VetName, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Grid.Column="1" VerticalAlignment="Center">
                                <Run Text="Дата:"/>
                                <Run Text="{Binding AppointmentDate, StringFormat=dd.MM.yyyy HH:mm}"/>
                            </TextBlock>

                            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                       FontWeight="Bold"
                                       Text="{Binding StatusName, Mode=OneWay}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="Отменить запись" Background="#FFB3B3" Click="Cancel_Click"/>
            <Button Content="Назад" Click="Back_Click" Background="#AAAAAA"/>
        </StackPanel>
    </Grid>
</Page>
