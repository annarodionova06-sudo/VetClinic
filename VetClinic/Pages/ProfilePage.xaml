<Page x:Class="VetClinic.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VetClinic.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Личный кабинет — Лапа и Хвост">
    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="500" HorizontalAlignment="Center">
                <TextBlock Text="Личный кабинет" FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="#5A3E85"/>

                <TextBlock x:Name="tbRole" FontSize="14" Foreground="#666"
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- Только для чтения -->
                <TextBlock Text="Роль" FontSize="14" Margin="0,0,0,5"/>
                <TextBox x:Name="txtRole" Height="35" IsReadOnly="True" Background="#F0F0F0"/>

                <TextBlock Text="Дата регистрации" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtRegDate" Height="35" IsReadOnly="True" Background="#F0F0F0"/>

                <!-- Редактируемые поля -->
                <TextBlock Text="Фамилия *" FontSize="14" Margin="0,20,0,5"/>
                <TextBox x:Name="txtSurname" Height="35"/>

                <TextBlock Text="Имя *" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtFirstName" Height="35"/>

                <TextBlock Text="Отчество" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtPatronymic" Height="35"/>

                <TextBlock Text="Email *" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtEmail" Height="35"/>

                <TextBlock Text="Телефон *" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtPhone" Height="35"/>

                <!-- Смена пароля -->
                <Border BorderBrush="#9B7ED9" BorderThickness="1" CornerRadius="4"
                        Padding="10" Margin="0,20,0,0" Background="#F9F5FF">
                    <StackPanel>
                        <TextBlock Text="Смена пароля" FontSize="16" FontWeight="Bold"
                                   Margin="0,0,0,10" Foreground="#5A3E85"/>

                        <TextBlock Text="Новый пароль" FontSize="14" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="txtNewPassword" Height="35"/>

                        <TextBlock Text="Подтверждение пароля" FontSize="14" Margin="0,10,0,5"/>
                        <PasswordBox x:Name="txtConfirmPassword" Height="35"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Content="Сохранить" Width="150" Height="40" Click="Save_Click"/>
                    <Button Content="Назад" Width="150" Height="40" Margin="10,0,0,0"
                            Click="Back_Click" Background="#AAAAAA"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>