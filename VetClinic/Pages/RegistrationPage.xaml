<Page x:Class="VetClinic.Pages.RegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VetClinic.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
 Title="Регистрация — Лапа и Хвост">
    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="500" HorizontalAlignment="Center">
                <TextBlock Text="Регистрация нового клиента"
                           FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,30"
                           Foreground="#5A3E85"/>

                <TextBlock Text="Фамилия *" FontSize="14" Margin="0,0,0,5"/>
                <TextBox x:Name="txtSurname" Height="35"/>

                <TextBlock Text="Имя *" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtFirstName" Height="35"/>

                <TextBlock Text="Отчество" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtPatronymic" Height="35"/>

                <TextBlock Text="Email *" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtEmail" Height="35"/>

                <TextBlock Text="Телефон *" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtPhone" Height="35"/>

                <TextBlock Text="Пароль *" FontSize="14" Margin="0,15,0,5"/>
                <PasswordBox x:Name="txtPassword" Height="35"/>

                <TextBlock Text="Подтверждение пароля *" FontSize="14" Margin="0,10,0,5"/>
                <PasswordBox x:Name="txtPasswordConfirm" Height="35"/>

                <TextBlock FontSize="12" Foreground="#666"
                           Text="* Обязательные поля" Margin="0,20,0,10"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Content="Зарегистрироваться" Width="200" Height="40"
                            Click="Register_Click" FontSize="16"/>
                    <Button Content="Назад" Width="150" Height="40" Margin="10,0,0,0"
                            Click="Back_Click" Background="#AAAAAA"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>