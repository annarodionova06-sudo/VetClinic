<Page x:Class="VetClinic.Pages.ServiceDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VetClinic.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
 Title="Редактирование услуги">
    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="500" HorizontalAlignment="Center">
                <TextBlock Text="Редактирование услуги" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#5A3E85"/>

                <TextBlock Text="Название услуги *" FontSize="14" Margin="0,0,0,5"/>
                <TextBox x:Name="txtName" Height="35"/>

                <TextBlock Text="Цена (₽) *" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtPrice" Height="35"/>

                <TextBlock Text="Длительность (минуты) *" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtDuration" Height="35"/>

                <TextBlock Text="Описание" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtDescription" Height="80" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Content="Сохранить" Width="150" Height="40" Click="Save_Click"/>
                    <Button Content="Отмена" Width="150" Height="40" Margin="10,0,0,0"
                            Click="Cancel_Click" Background="#AAAAAA"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>