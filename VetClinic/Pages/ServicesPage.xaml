<Page x:Class="VetClinic.Pages.ServicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VetClinic.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Услуги — Лапа и Хвост">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="filterPanel" Grid.Row="0" Orientation="Horizontal" Margin="5">
            <ComboBox x:Name="cmbSort" Width="180" Margin="5" SelectionChanged="Filters_Changed"/>
            <TextBox x:Name="txtSearch" Width="250" Margin="5" TextChanged="Filters_Changed"
                     ToolTip="Поиск по названию и описанию"/>
        </StackPanel>

      <ListView x:Name="listServices" Grid.Row="1" 
          MouseDoubleClick="listServices_MouseDoubleClick"
          HorizontalContentAlignment="Stretch">
    <ListView.ItemTemplate>
        <DataTemplate>
            <Border Margin="5" Padding="15" BorderBrush="#9B7ED9" BorderThickness="1"
                    Background="{Binding RowColor, Mode=OneWay}" CornerRadius="4"
                    MinHeight="100">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock FontSize="18" FontWeight="{Binding PriceHighlight, Mode=OneWay}">
                            <Run Text="{Binding ServiceName}"/>
                        </TextBlock>
                        <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" MaxWidth="500">
                            <Run Text="{Binding Description}"/>
                        </TextBlock>
                        <TextBlock Margin="0,5,0,0" Foreground="#666">
                            <Run Text="Длительность:"/>
                            <Run Text="{Binding DurationMinutes}"/>
                            <Run Text=" мин"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Right" Margin="0,0,0,8"
                                   Text="{Binding Price, StringFormat={}{0:N2} ₽}"/>
                        <Button Content="В корзину" Width="120" Height="30"
                                Click="AddServiceToCart_Click"
                                Tag="{Binding}"
                                FontSize="12" Padding="5,3"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </ListView.ItemTemplate>
</ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button x:Name="btnDeleteService" Content="Удалить" Background="#FFB3B3"
            Click="Del_Click" Visibility="Collapsed"/>
            <Button Content="Лекарства" Click="Medicines_Click"/>
            <Button Content="Корзина услуг" Click="CartServices_Click"/>
            <Button Content="Корзина лекарств" Click="CartMedicines_Click"/>
            <Button Content="Мои записи" Click="Appointments_Click"/>
            <Button Content="Мои заказы" Click="Orders_Click"/>
            <Button Content="Выход" Click="Exit_Click" Background="#AAAAAA"/>
            </StackPanel>
    </Grid>
</Page>