<Page x:Class="VetClinic.Pages.TableViewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VetClinic.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
       Title="Просмотр таблицы">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="tblTitle" Grid.Row="0" FontSize="22" FontWeight="Bold" 
                   Foreground="#6A4C93" Margin="0,0,0,15"/>

        <DataGrid x:Name="dgData" Grid.Row="1" 
                  AutoGenerateColumns="True" 
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  GridLinesVisibility="All"
                  BorderBrush="#9B7ED9" BorderThickness="1"
                  RowBackground="#F5F0FF" AlternatingRowBackground="#E8DEF5"
                  HeadersVisibility="Column"
                  FontSize="13"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="Назад" Padding="20,8" Background="#AAAAAA" Foreground="White" 
                    BorderThickness="0" Cursor="Hand" Click="BtnBack_Click" Margin="5"/>
        </StackPanel>
    </Grid>
</Page>